rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email_verified == true && 
             request.auth.token.email.lower() == 'skyatuiuc@gmail.com';
    }
    
    function isVolunteer() {
      return isAuthenticated() && (
        isAdmin() || 
        exists(/databases/$(database)/documents/authorized_volunteers/$(request.auth.token.email.lower()))
      );
    }

    // 2. Participant Registrations, Group Assignments & Attendance Tracking
    match /registrations/{document} {
      // On creation: applicants may only create their own record ({email}_{retreatId}) for an existing
      // retreat (or the 'general' interest list), with schema-v2 keys, size limits and an initial status.
      allow create: if isVolunteer() || (
        isAuthenticated() &&
        document == request.auth.token.email.lower() + '_' + request.resource.data.retreatId &&
        request.resource.data.email == request.auth.token.email.lower() &&
        (request.resource.data.retreatId == 'general' || exists(/databases/$(database)/documents/retreat_history/$(request.resource.data.retreatId))) &&
        request.resource.data.keys().hasOnly([
          'retreatId', 'firstName', 'lastName', 'email', 'phone', 'isOver18', 'academicRole',
          'completedSkyBefore', 'healthConditions', 'otherHealthConditions', 'foodAllergies',
          'referralSource', 'status', 'appliedAt', 'updatedAt'
        ]) &&
        request.resource.data.firstName is string && request.resource.data.firstName.size() <= 100 &&
        request.resource.data.lastName is string && request.resource.data.lastName.size() <= 100 &&
        request.resource.data.phone is string && request.resource.data.phone.size() <= 30 &&
        request.resource.data.isOver18 is string && request.resource.data.isOver18.size() <= 20 &&
        request.resource.data.academicRole is string && request.resource.data.academicRole.size() <= 50 &&
        request.resource.data.completedSkyBefore is string && request.resource.data.completedSkyBefore.size() <= 10 &&
        request.resource.data.healthConditions is list && request.resource.data.healthConditions.size() <= 15 &&
        request.resource.data.otherHealthConditions is string && request.resource.data.otherHealthConditions.size() <= 1000 &&
        request.resource.data.foodAllergies is string && request.resource.data.foodAllergies.size() <= 500 &&
        request.resource.data.referralSource is string && request.resource.data.referralSource.size() <= 250 &&
        request.resource.data.status in ['Uncontacted', 'Pending'] &&
        request.resource.data.appliedAt is string && request.resource.data.appliedAt.size() <= 40
      );

      allow read: if isVolunteer() || (isAuthenticated() && resource.data.email.lower() == request.auth.token.email.lower());
      
      // Strict field protection: Applicants cannot modify applications once submitted.
      // All registration updates are strictly reserved for authorized volunteers and super admins.
      allow update: if isVolunteer();
      
      allow delete: if isAdmin();
    }

    // 2b. Volunteer-only notes about a registration (same document id). Applicants cannot read these.
    match /registration_private/{document} {
      allow read, write: if isVolunteer();
    }

    // 3. Authorized Volunteer Whitelist (Users can only verify themselves; volunteers can list)
    match /authorized_volunteers/{userEmail} {
      allow get: if isAuthenticated() && (request.auth.token.email.lower() == userEmail.lower() || isVolunteer());
      allow list: if isVolunteer();
      allow write, create, update, delete: if isAdmin();
    }
    
    // 4. System Settings (Email Dispatch Webhook, Global Link Configurations)
    match /system_settings/{document} {
      allow read: if isVolunteer();
      allow write: if isAdmin();
    }

    // 5. Retreat Event Records, History & Group Configurations
    match /retreat_history/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Retreat Flyer Templates Studio (Super Admin creates/edits, Volunteers read)
    match /flyer_templates/{document} {
      allow read: if isVolunteer();
      allow write, create, update, delete: if isAdmin();

      // Chunk Subcollection for Lossless Image Slices
      match /chunks/{chunkId} {
        allow read: if isVolunteer();
        allow write, create, update, delete: if isAdmin();
      }
    }

    // 8. Retreat Nametag Templates Studio (Super Admin creates/edits, Volunteers read)
    match /nametag_templates/{document} {
      allow read: if isVolunteer();
      allow write, create, update, delete: if isAdmin();

      // Chunk Subcollection for Lossless Image Slices
      match /chunks/{chunkId} {
        allow read: if isVolunteer();
        allow write, create, update, delete: if isAdmin();
      }
    }
  }
}


