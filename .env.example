# Firebase Web Configuration for SKY at UIUC
# Obtain these keys from your Firebase Console project: https://console.firebase.google.com

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=skyatuiuc-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=skyatuiuc-web
VITE_FIREBASE_STORAGE_BUCKET=skyatuiuc-web.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Optional Dispatch & Community Link Configurations
VITE_EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec
VITE_DAILY_PRACTICE_LINK=https://illinois.zoom.us/j/YOUR_ZOOM_MEETING_ID
VITE_WHATSAPP_LINK=https://chat.whatsapp.com/YOUR_WHATSAPP_INVITE_CODE
VITE_SURVEY_LINK=https://forms.gle/YOUR_SURVEY_FORM_ID
